{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/components/ui/**/*.ts", "src/components/ui/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**", "../../features/**", "../../../features/**"],
                "message": "components/ui must not import from src/features/* — dependencies flow components/ui → features/* → app/routes. See src/components/ui/README.md."
              },
              {
                "group": ["@/app/**", "../../app/**", "../../../app/**"],
                "message": "components/ui must not import from src/app/* — dependencies flow components/ui → features/* → app/routes. See src/components/ui/README.md."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/test/**/*.ts", "src/test/**/*.tsx"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
